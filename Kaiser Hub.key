-- ============================================================
-- SYSTEM: HEAD EXPANDER (เกิด=ขยาย, ตาย=ลบ, ออก=ลบ, เข้าใหม่=ขยาย)
-- ============================================================
local activeConnections = {}

-- ลบขยายหัวเมื่อตาย/ออก
local function removeHeadExpand(player)
    if activeConnections[player] then
        for _, conn in pairs(activeConnections[player]) do
            conn:Disconnect()
        end
        activeConnections[player] = nil
    end
end

-- ขยายหัวตัวละคร
local function applyHead(character)
    if not character then return end
    local head = character:WaitForChild("Head", 5)
    local humanoid = character:WaitForChild("Humanoid", 5)

    if head and humanoid then
        pcall(function()
            head.Size = CONFIG.HEAD_SIZE
            head.Transparency = CONFIG.HEAD_TRANSPARENCY
            head.CanCollide = false
            head.Massless = true
            head.Material = Enum.Material.ForceField
            head.Color = Color3.fromRGB(0, 230, 255)

            local mesh = head:FindFirstChildOfClass("SpecialMesh")
            if mesh then mesh.Scale = Vector3.new(1, 1, 1) end
            if head:FindFirstChild("face") then head.face.Transparency = 1 end
        end)

        -- ดักจับเมื่อผู้เล่น "ตาย" ให้ลบการขยายหัวออก
        humanoid.Died:Connect(function()
            pcall(function()
                head.Size = Vector3.new(1.2, 1.2, 1.2)
                head.Transparency = 0
            end)
        end)
    end
end

-- ตั้งค่าผู้เล่น (เข้าใหม่ / เกิดใหม่)
local function setupPlayer(player)
    if player == LocalPlayer then return end
    
    activeConnections[player] = {}

    -- เกิดใหม่ = ขยาย
    if player.Character then applyHead(player.Character) end
    local charAddedConn = player.CharacterAdded:Connect(applyHead)
    table.insert(activeConnections[player], charAddedConn)
end

local function startHeadExpanderSystem()
    -- ผู้เล่นที่มีอยู่ในเซิร์ฟตอนนี้
    for _, player in ipairs(Players:GetPlayers()) do
        setupPlayer(player)
    end

    -- เข้ามาใหม่ = ขยาย
    Players.PlayerAdded:Connect(setupPlayer)

    -- ออก = ลบข้อมูล
    Players.PlayerRemoving:Connect(function(player)
        removeHeadExpand(player)
    end)
end

-- ============================================================
-- SUBMIT PROCESS
-- ============================================================
local isProcessing = false

local function onVerify()
    if isProcessing then return end
    isProcessing = true
    
    local enteredKey = KeyBox.Text:gsub("%s+", "")
    
    if enteredKey == CONFIG.CORRECT_KEY then
        SubmitBtn.Text = "✔ KEY CORRECT!"
        SubmitBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        StatusLabel.Text = "กำลังเริ่มทำงานระบบ..."
        StatusLabel.TextColor3 = Color3.fromRGB(0, 200, 100)

        -- เริ่มระบบขยายหัวแบบ Event
        task.spawn(startHeadExpanderSystem)

        -- โหลดสคริปต์หลัก
        task.spawn(function()
            pcall(function()
                loadstring(game:HttpGet(CONFIG.HUB_URL))()
            end)
        end)

        task.wait(1.5)
        closeUI()
    else
        SubmitBtn.Text = "❌ KEY INCORRECT!"
        SubmitBtn.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
        StatusLabel.Text = "⚠ คีย์ไม่ถูกต้อง กรุณาลองใหม่อีกครั้ง"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 60, 60)

        -- Shake Animation
        local origPos = MainFrame.Position
        for i = 1, 4 do
            MainFrame.Position = origPos + UDim2.new(0, (i % 2 == 0 and 4 or -4), 0, 0)
            task.wait(0.04)
        end
        MainFrame.Position = origPos

        task.wait(1.5)
        SubmitBtn.Text = "SUBMIT KEY"
        SubmitBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
        StatusLabel.Text = ""
        isProcessing = false
    end
end

SubmitBtn.MouseButton1Click:Connect(onVerify)
KeyBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then onVerify() end
end)

