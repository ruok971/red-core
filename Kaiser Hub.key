local UIScale = create("UIScale", { Parent = MainFrame, Scale = 1 })
local function adjustScale()
    local cam = workspace.CurrentCamera
    if cam and cam.ViewportSize.X < 600 then
        UIScale.Scale = 0.85
    else
        UIScale.Scale = 1
    end
end
adjustScale()

