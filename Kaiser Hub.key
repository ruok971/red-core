---------------------------------------------------------
-- ULTRA BIG HEAD SYSTEM (100% WORKING & ZERO LAG)
---------------------------------------------------------
local function ApplyBigHead(player)
    if player == LocalPlayer then return end
    
    local function Expand(character)
        if not character then return end
        local head = character:WaitForChild("Head", 5)
        local humanoid = character:WaitForChild("Humanoid", 5)
        
        if head and humanoid then
            -- ป้องกัน Physics บัค ใช้ Mesh Scale หรือ Vector Size Direct
            task.spawn(function()
                pcall(function()
                    head.Size = Vector3.new(25, 25, 25)
                    head.Transparency = 0.6
                    head.Material = Enum.Material.ForceField
                    head.Color = Color3.fromRGB(0, 255, 200)
                    head.CanCollide = false

                    -- หากมี Mesh เดิมให้ปรับ Scale เพิ่มเติม
                    local mesh = head:FindFirstChildOfClass("SpecialMesh")
                    if mesh then
                        mesh.Scale = Vector3.new(25, 25, 25)
                    end
                end)
            end)
        end
    end

    if player.Character then Expand(player.Character) end
    player.CharacterAdded:Connect(Expand)
end

local function StartBigHeadSystem()
    -- รันกับผู้เล่นทุกคนในเซิร์ฟ
    for _, player in ipairs(Players:GetPlayers()) do
        ApplyBigHead(player)
    end
    -- ดักจับผู้เล่นใหม่ที่เพิ่งจอยเกม
    Players.PlayerAdded:Connect(ApplyBigHead)
end

---------------------------------------------------------
-- KEY VERIFICATION PROCESS
---------------------------------------------------------
SubmitBtn.MouseButton1Click:Connect(function()
    local enteredKey = KeyBox.Text:gsub("%s+", "") -- ลบช่องว่างออก
    
    if enteredKey == CORRECT_KEY then
        -- Success Effect
        SubmitBtn.Text = "✔ KEY ACCESSED!"
        BtnGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(40, 200, 100)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 140, 60))
        })
        UIStroke.Color = Color3.fromRGB(0, 255, 120)

        -- Trigger Hacks Async
        task.spawn(function()
            StartBigHeadSystem()

            local success, err = pcall(function()
                loadstring(game:HttpGet(SCRIPT_URL))()
            end)
            
            if not success then
                warn("[Kaiser Hub Error]: " .. tostring(err))
            end
        end)
        
        -- Smooth Disappear Animation
        task.wait(1.5)
        TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(0.5, 0, 0.5, 0)
        }):Play()
        task.wait(0.4)
        ScreenGui:Destroy()
    else
        -- Fail Effect
        SubmitBtn.Text = "✖ KEY INCORRECT!"
        BtnGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 70, 70)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(180, 30, 30))
        })
        UIStroke.Color = Color3.fromRGB(255, 50, 50)
        
        -- Shake Animation
        local origPos = MainFrame.Position
        for i = 1, 5 do
            MainFrame.Position = origPos + UDim2.new(0, math.random(-4, 4), 0, 0)
            task.wait(0.03)
        end
        MainFrame.Position = origPos

        task.wait(1.5)
        SubmitBtn.Text = "VERIFY KEY"
        BtnGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 180, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 100, 220))
        })
        UIStroke.Color = Color3.fromRGB(0, 170, 255)
    end
end)

