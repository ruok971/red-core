-- ============================================================
-- CONFIGURATION
-- ============================================================
local CORRECT_KEY = "CD-R-347-90-FG"
local HUB_URL = "https://raw.githubusercontent.com/ruok971/red-core/refs/heads/main/Kaiser%20Hub_bloxspin_OPGG.lua.txt"

-- ============================================================
-- SERVICES
-- ============================================================
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- ============================================================
-- COLORS
-- ============================================================
local C = {
    bg = Color3.fromRGB(20, 20, 30),
    card = Color3.fromRGB(28, 28, 40),
    topbar = Color3.fromRGB(35, 35, 50),
    input = Color3.fromRGB(38, 38, 55),
    primary = Color3.fromRGB(0, 150, 255),
    primaryHover = Color3.fromRGB(0, 175, 255),
    success = Color3.fromRGB(0, 200, 120),
    error = Color3.fromRGB(255, 60, 60),
    text = Color3.fromRGB(255, 255, 255),
    dim = Color3.fromRGB(150, 150, 170),
}

-- ============================================================
-- HELPER: Create Instance with Properties
-- ============================================================
local function mk(class, props)
    local o = Instance.new(class)
    if props then for k, v in pairs(props) do o[k] = v end end
    return o
end

-- ============================================================
-- HELPER: Tween
-- ============================================================
local function tw(obj, props, dur)
    dur = dur or 0.25
    TweenService:Create(obj, TweenInfo.new(dur, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props):Play()
end

-- ============================================================
-- BUILD UI
-- ============================================================
local gui = mk("ScreenGui", {
    Name = "KaiserHub",
    Parent = game.CoreGui,
    ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    ResetOnSpawn = false,
})

