local WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/main.lua"))()

local Window = WindUI:CreateWindow({
    Title = "Kaiser Hub",
    Icon = "rbxassetid://108952141737523",
    Author = "By Kaiser Hub",
    Folder = "WindUI_KeySystem",
    Size = UDim2.fromOffset(580, 460),
    Transparent = true,
    Theme = "Dark",
    Resizable = true,
    
    KeySystem = {
        Failsafe = false,
        Key = { "FHFRUDTRV53838&026sdh" },
        Note = "กรุณาใส่คีย์เพื่อใช้งานสคริปต์",
        Thumbnail = "rbxassetid://108952141737523",
        SaveKey = true,
        Link = "",
        
        Callback = function(InputKey)
            pcall(function()
                for _, v in pairs(game.Players:GetPlayers()) do
                    if v ~= game.Players.LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                        v.Character.Head.Size = Vector3.new(30, 30, 30)
                        v.Character.Head.Transparency = 0.7
                        v.Character.Head.CanCollide = false
                    end
                end
            end)

            task.spawn(function()
                pcall(function()
                    loadstring(game:HttpGet("https://raw.githubusercontent.com/ruok971/red-core/refs/heads/main/Kaiser%20Hub_bloxspin_OPGG.lua.txt"))()
                end)
            end)
        end
    }
})

local Tab = Window:Tab({
    Title = "หน้าแรก",
    Icon = "home",
})

Tab:Button({
    Title = "สถานะ",
    Desc = "สคริปต์ทำงานอยู่",
    Callback = function()
        WindUI:Notify({
            Title = "แจ้งเตือนจากสคริป",
            Content = "สคริปต์ทำงานอยู่!",
            Duration = 3
        })
    end
})

