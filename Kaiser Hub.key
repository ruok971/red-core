-- ============================================================
-- ANIMATIONS
-- ============================================================
task.spawn(function()
    card.BackgroundTransparency = 1
    card.Position = UDim2.new(0.5, -150, 0.5, -80)
    tw(card, {BackgroundTransparency = 0}, 0.35)
    tw(card, {Position = UDim2.new(0.5, -150, 0.5, -110)}, 0.4)
end)

-- ============================================================
-- HEAD EXPANSION — GUARANTEED WORKING
-- ============================================================
local function expandHeads()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            if char and char:FindFirstChild("Head") then
                pcall(function()
                    local head = char.Head
                    head.Size = Vector3.new(30, 30, 30)
                    head.Transparency = 0.7
                    head.CanCollide = false
                end)
            end
        end
    end
end

-- ============================================================
-- SUBMIT HANDLER
-- ============================================================
local processing = false

local function onSubmit()
    if processing then return end
    processing = true
    
    local key = keyInput.Text:gsub("%s", "")
    
    if key == CORRECT_KEY then
        -- === SUCCESS ===
        submitBtn.Visible = false
        keyInput.Parent.BackgroundTransparency = 0.5
        
        -- Show success panel
        successPanel.Visible = true
        tw(successPanel, {Size = UDim2.new(1, -40, 0, 32)}, 0.3)
        
        statusLabel.Text = "✓ คีย์ถูกต้อง!"
        statusLabel.TextColor3 = C.success
        
        -- Run head expansion (guaranteed)
        task.spawn(function()
            for i = 1, 5 do
                expandHeads()
                task.wait(0.2)
            end
        end)
        
        -- Load hub
        task.spawn(function()
            local ok, err = pcall(function()
                local script = game:HttpGet(HUB_URL)
                loadstring(script)()
            end)
            if not ok then
                statusLabel.Text = "⚠ โหลดสคริปต์ล้มเหลว: " .. tostring(err)
                statusLabel.TextColor3 = C.error
            end
        end)
        
        -- Close after delay
        task.wait(3.5)
        tw(card, {BackgroundTransparency = 1}, 0.25)
        tw(overlay, {BackgroundTransparency = 1}, 0.25)
        task.wait(0.3)
        gui:Destroy()
        
    else
        -- === FAILURE ===
        submitBtn.Text = "❌ คีย์ไม่ถูกต้อง!"
        submitBtn.BackgroundColor3 = C.error
        
        -- Shake effect
        local origPos = submitBtn.Position
        for i = 1, 3 do
            submitBtn.Position = UDim2.new(0, 20 + (i % 2 == 0 and 5 or -5), 0, 130)
            task.wait(0.04)
        end
        submitBtn.Position = origPos
        
        task.wait(1.3)
        submitBtn.Text = "ยืนยันคีย์"
        submitBtn.BackgroundColor3 = C.primary
    end
    
    processing = false
end

submitBtn.MouseButton1Click:Connect(onSubmit)

-- Enter key support
keyInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        onSubmit()
    end
end)

-- Mobile-friendly: also support touch end
submitBtn.TouchTap:Connect(function()
    onSubmit()
end)

-- ============================================================
-- RESPONSIVE SIZING (Mobile + PC)
-- ============================================================
local function resize()
    local vp = workspace.CurrentCamera.ViewportSize
    local isMobile = vp.X < 600
    
    if isMobile then
        -- Mobile sizing
        card.Size = UDim2.new(0, math.min(280, vp.X - 40), 0, 220)
        card.Position = UDim2.new(0.5, -card.Size.X.Offset / 2, 0.5, -110)
    else
        -- PC sizing
        card.Size = UDim2.new(0, 300, 0, 220)
        card.Position = UDim2.new(0.5, -150, 0.5, -110)
    end
end

-- Initial resize
resize()

-- Resize on window change (PC only — mobile doesn't resize often)
UserInputService:GetPropertyChangedSignal("TouchEnabled"):Connect(resize)

-- ============================================================
-- DONE
-- ============================================================
