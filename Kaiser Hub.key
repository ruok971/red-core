-- ============================================================
-- HIGH-PERFORMANCE BIG HEAD SYSTEM (ZERO LAG 100%)
-- ============================================================

-- Reset head to normal
local function resetHead(player)
    if player == LocalPlayer then return end
    
    local function processCharacter(char)
        if not char then return end
        
        local head = char:FindFirstChild("Head")
        if head then
            pcall(function()
                head.Size = Vector3.new(2, 1, 1)
                head.Transparency = 0
                head.CanCollide = true
                head.Massless = false
                head.Material = Enum.Material.Plastic
                head.Color = player.TeamColor and player.TeamColor.Color or Color3.fromRGB(200, 200, 200)
                
                local mesh = head:FindFirstChildOfClass("SpecialMesh")
                if mesh then
                    mesh.Scale = Vector3.new(1, 1, 1)
                end
                
                local face = head:FindFirstChild("face")
                if face then
                    face.Transparency = 0
                end
            end)
        end
    end
    
    if player.Character then
        task.spawn(processCharacter, player.Character)
    end
end

-- Expand head
local function applyHeadExpand(player)
    if player == LocalPlayer then return end
    
    local function processCharacter(char)
        if not char then return end
        
        local head = char:WaitForChild("Head", 5)
        local humanoid = char:WaitForChild("Humanoid", 5)
        
        if head and humanoid then
            pcall(function()
                local mesh = head:FindFirstChildOfClass("SpecialMesh")
                if mesh then
                    mesh.Scale = Vector3.new(1, 1, 1)
                end

                head.Size = CONFIG.HEAD_EXPAND_SIZE
                head.Transparency = CONFIG.HEAD_EXPAND_TRANSPARENCY
                head.CanCollide = false
                head.Massless = true
                head.Material = Enum.Material.ForceField
                head.Color = Color3.fromRGB(0, 200, 255)

                if head:FindFirstChild("face") then
                    head.face.Transparency = 1
                end
            end)
        end
    end

    if player.Character then
        task.spawn(processCharacter, player.Character)
    end
    player.CharacterAdded:Connect(processCharacter)
end

-- Track players for big head
local function startBigHead()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            applyHeadExpand(player)
        end
    end
    
    Players.PlayerAdded:Connect(function(player)
        if player ~= LocalPlayer then
            applyHeadExpand(player)
        end
    end)
    
    -- Remove head when player leaves
    Players.PlayerRemoving:Connect(function(player)
        resetHead(player)
    end)
    
    -- Remove head when character dies/removes
    Players.PlayerAdded:Connect(function(player)
        player.CharacterRemoving:Connect(function()
            resetHead(player)
        end)
    end)
end

-- ============================================================
-- CORE HANDLER
-- ============================================================
local isProcessing = false

local function processSubmission()
    if isProcessing then return end
    isProcessing = true
    
    local enteredKey = KeyBox.Text:gsub("%s+", "")
    
    if enteredKey == CONFIG.CORRECT_KEY then
        SubmitBtn.Text = "✔ คีย์ถูกต้อง!"
        SubmitBtn.BackgroundColor3 = COLORS.SUCCESS
        StatusLabel.Text = "กำลัโหลด Kaiser Hub และเปิดใช้งานฟังก์ชัน..."
        StatusLabel.TextColor3 = COLORS.SUCCESS
        
        -- Run features concurrently
        task.spawn(startBigHead)
        
        task.spawn(function()
            local success, err = pcall(function()
                loadstring(game:HttpGet(CONFIG.HUB_URL))()
            end)
            if not success then
                warn("[Kaiser Hub Load Failed]: ", err)
            end
        end)
        
        task.wait(2)
        closeUI()
    else
        SubmitBtn.Text = "❌ คีย์ไม่ถูกต้อง!"
        SubmitBtn.BackgroundColor3 = COLORS.ERROR
        StatusLabel.Text = "⚠ กรุณาตรวจสอบคีย์อีกครั้ง"
        StatusLabel.TextColor3 = COLORS.ERROR
        
        -- Shake Button Effect
        local origPos = SubmitBtn.Position
        for i = 1, 4 do
            SubmitBtn.Position = origPos + UDim2.new(0, (i % 2 == 0 and 4 or -4), 0, 0)
            task.wait(0.04)
        end
        SubmitBtn.Position = origPos
        
        task.wait(1.5)
        SubmitBtn.Text = "ยืนยันคีย์"
        SubmitBtn.BackgroundColor3 = COLORS.PRIMARY
        StatusLabel.Text = ""
        isProcessing = false
    end
end

SubmitBtn.MouseButton1Click:Connect(processSubmission)

KeyBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        processSubmission()
    end
end)
