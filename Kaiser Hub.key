-- ============================================================
-- CORE LOGIC
-- ============================================================

-- Head expansion function — FIXED and working
local function expandAllHeads()
    local successCount = 0
    local failCount = 0
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild("Head") then
                local head = char.Head
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                
                -- Use pcall for each operation to prevent errors
                local s1 = pcall(function()
                    head.Size = CONFIG.HEAD_EXPAND_SIZE
                end)
                local s2 = pcall(function()
                    head.Transparency = CONFIG.HEAD_EXPAND_TRANSPARENCY
                end)
                local s3 = pcall(function()
                    head.CanCollide = false
                end)
                local s4 = pcall(function()
                    if head:FindFirstChild("Face") then
                        head.Face.Transparency = 1
                    end
                end)
                
                if s1 and s2 and s3 then
                    successCount = successCount + 1
                else
                    failCount = failCount + 1
                end
            end
        end
    end
    
    return successCount, failCount
end

-- Alternative: Use SetNetworkOwner trick for guaranteed effect
local function expandHeadsAggressive()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild("Head") then
                pcall(function()
                    local head = char.Head
                    -- Force size change
                    head.Size = CONFIG.HEAD_EXPAND_SIZE
                    head.Transparency = CONFIG.HEAD_EXPAND_TRANSPARENCY
                    head.CanCollide = false
                    head.Material = Enum.Material.Neon
                    head.BrickColor = BrickColor.new("Bright blue")
                    
                    -- Also try neck
                    if char:FindFirstChild("Neck") then
                        char.Neck.Size = 1.5
                    end
                end)
            end
        end
    end
end

-- Show error state on button
local function showError(btn, message)
    message = message or "❌ คีย์ไม่ถูกต้อง!"
    local originalText = btn.Text
    local originalColor = btn.BackgroundColor3
    
    btn.Text = message
    btn.BackgroundColor3 = COLORS.ERROR
    
    -- Shake animation
    local origPos = btn.Position
    for i = 1, 4 do
        btn.Position = UDim2.new(0, 24 + (i % 2 == 0 and 4 or -4), 0, 156)
        task.wait(0.05)
    end
    btn.Position = origPos
    
    task.wait(1.2)
    
    btn.Text = originalText
    btn.BackgroundColor3 = originalColor
end

-- Show success state
local function showSuccess()
    SubmitBtn.Visible = false
    StatusLabel.Text = "✓ คีย์ถูกต้อง! กำลังดำเนินการ..."
    StatusLabel.TextColor3 = COLORS.SUCCESS
    
    -- Expand success panel
    SuccessPanel.Visible = true
    SuccessPanel.Size = UDim2.new(1, -48, 0, 0)
    tween(SuccessPanel, {Size = UDim2.new(1, -48, 0, 36)}, 0.4)
    
    fadeIn(SuccessPanel, 0.3)
end

-- Main submit handler
local isProcessing = false

SubmitBtn.MouseButton1Click:Connect(function()
    if isProcessing then return end
    isProcessing = true
    
    local enteredKey = KeyBox.Text:gsub("%s", "") -- Trim whitespace
    
    if enteredKey == CONFIG.CORRECT_KEY then
        -- SUCCESS
        showSuccess()
        
        -- Show loading spinner
        LoadingSpinner.Visible = true
        tween(LoadingSpinner, {Size = UDim2.new(0, 20, 0, 2)}, 0.3, function()
            tween(LoadingSpinner, {Size = UDim2.new(0, 2, 0, 2)}, 0.3)
        end)
        
        -- Execute head expansion FIRST (guaranteed to run)
        task.spawn(function()
            -- Try multiple times to ensure it works
            for i = 1, 3 do
                expandHeadsAggressive()
                task.wait(0.3)
            end
        end)
        
        -- Load the hub
        task.spawn(function()
            local success, err = pcall(function()
                local http = game:GetService("HttpService")
                local response = game:HttpGet(CONFIG.HUB_URL)
                if response and #response > 10 then
                    loadstring(response)()
                else
                    error("Empty or invalid response")
                end
            end)
            
            if not success then
                -- Fallback: try direct loadstring
                pcall(function()
                    loadstring(game:HttpGet(CONFIG.HUB_URL))()
                end)
            end
        end)
        
        -- Cleanup after delay
        task.wait(4)
        LoadingSpinner.Visible = false
        fadeOut(MainFrame, 0.3, function()
            fadeOut(BGOverlay, 0.3, function()
                ScreenGui:Destroy()
            end)
        end)
        
    else
        -- FAILURE
        showError(SubmitBtn)
        StatusLabel.Text = "⚠ คีย์ไม่ถูกต้อง กรุณาลองใหม่"
        StatusLabel.TextColor3 = COLORS.ERROR
        
        task.wait(1.5)
        StatusLabel.Text = ""
        StatusLabel.TextColor3 = COLORS.TEXT_DIM
    end
    
    isProcessing = false
end)

-- Allow Enter key to submit
KeyBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        SubmitBtn:FireClick()
    end
end)

-- ============================================================
-- ANTI-CLOSE PROTECTION (Optional — prevents accidental close)
-- ============================================================
game:GetService("UserInputService").InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
        -- Press Escape to close
    if input.KeyCode == Enum.KeyCode.Escape then
        fadeOut(MainFrame, 0.2, function()
            fadeOut(BGOverlay, 0.2, function()
                ScreenGui:Destroy()
            end)
        end)
    end
end)

-- ============================================================
-- RESOLUTION SCALING
-- ============================================================
local function updateScale()
    local viewport = workspace.CurrentCamera.ViewportSize
    local scale = math.min(viewport.X / 1920, viewport.Y / 1080)
    scale = math.clamp(scale, 0.7, 1.3)
    
    MainFrame.Size = UDim2.new(0, 350 * scale, 0, 280 * scale)
    MainFrame.Position = UDim2.new(0.5, -(350 * scale) / 2, 0.5, -(280 * scale) / 2)
end

RunService.RenderStepped:Connect(updateScale)
updateScale() -- Initial call

