-- Responsive Scaling for Mobile & PC
local UIScale = createInstance("UIScale", {
    Parent = MainFrame,
    Scale = 1
})

local function adjustScale()
    local camera = workspace.CurrentCamera
    if camera then
        local viewportSize = camera.ViewportSize
        if viewportSize.X < 600 then
            UIScale.Scale = 0.85
        else
            UIScale.Scale = 1
        end
    end
end
adjustScale()

